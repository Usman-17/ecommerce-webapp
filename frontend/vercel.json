{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://galaxydials-ecommerce-store.onrender.com/api/$1"
    },
    {
      "source": "/p/(.*)",
      "destination": "https://galaxydials-ecommerce-store.onrender.com/p/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
